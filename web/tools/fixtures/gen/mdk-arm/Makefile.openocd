# OpenOCD Makefile for MDK-ARM
# Auto-generated by uvprojx2cmake.py
#
# This Makefile provides convenient targets for OpenOCD debugging and programming
#
# Requirements:
#   - OpenOCD installed and in PATH
#   - OpenOCD config files for your interface and target
#
# Usage:
#   make openocd-erase    - Erase entire flash
#   make openocd-prog     - Program the firmware
#   make openocd-gdb      - Start OpenOCD GDB server
#   make openocd-debug    - Start GDB debug session (requires openocd-gdb)
#   make openocd-reset    - Reset target

# =============================================================================
# Configuration
# =============================================================================

# OpenOCD root directory (modify this if using custom OpenOCD installation)
# Examples:
#   MounRiver Studio: E:/MounRiver/MounRiver_Studio2/resources/app/resources/win32/components/WCH/OpenOCD/OpenOCD
#   Default Windows: C:/openocd
#   Default Linux: /usr
OPENOCD_ROOT ?= E:/MounRiver/MounRiver_Studio2/resources/app/resources/win32/components/WCH/OpenOCD/OpenOCD

# OpenOCD executable
OPENOCD ?= $(OPENOCD_ROOT)/bin/openocd

# OpenOCD scripts directory
OPENOCD_SCRIPTS ?= $(OPENOCD_ROOT)/scripts

# OpenOCD interface config (relative to scripts dir, or absolute path)
OPENOCD_INTERFACE ?= interface/cmsis-dap.cfg

# OpenOCD target config (relative to scripts dir, or absolute path)
OPENOCD_TARGET ?= target/stm32f1x.cfg

# OpenOCD frequency (kHz)
OPENOCD_FREQ ?= 10000

# GDB configuration
GDB ?= arm-none-eabi-gdb
GDB_PORT ?= 3333
GDB_SCRIPT ?= jlink_gdb.script

# Build output files
BUILD_DIR ?= build
ELF_FILE ?= $(BUILD_DIR)/MDK-ARM.elf
HEX_FILE ?= $(BUILD_DIR)/MDK-ARM.hex
BIN_FILE ?= $(BUILD_DIR)/MDK-ARM.bin

# CMake configuration
CMAKE ?= cmake
CMAKE_BUILD_TYPE ?= Debug
CMAKE_GENERATOR ?= Ninja

# OpenOCD command with scripts path
OPENOCD_CMD = $(OPENOCD) -s $(OPENOCD_SCRIPTS)

# =============================================================================
# Targets
# =============================================================================

.PHONY: all build clean cmake openocd-erase openocd-prog openocd-gdb openocd-debug openocd-reset openocd-halt openocd-help

# Default target: build everything
all: build

# CMake configure
cmake:
	@echo "Configuring with CMake..."
	$(CMAKE) -S . -B $(BUILD_DIR) -G $(CMAKE_GENERATOR) -DCMAKE_BUILD_TYPE=$(CMAKE_BUILD_TYPE)

# Build the project
build: cmake
	@echo "Building project..."
	$(CMAKE) --build $(BUILD_DIR)

# Clean build directory
clean:
	@echo "Cleaning build directory..."
	-rmdir /s /q $(BUILD_DIR) 2>nul || rm -rf $(BUILD_DIR) 2>/dev/null || true

# Erase entire flash
openocd-erase:
	@echo "Erasing flash with OpenOCD..."
	$(OPENOCD_CMD) -f $(OPENOCD_INTERFACE) -f $(OPENOCD_TARGET) -c "init; adapter speed $(OPENOCD_FREQ); halt; flash erase_sector 0 0 last; exit"

# Program firmware (using .elf file, requires pre-built elf file)
openocd-prog:
	@echo "Programming $(ELF_FILE) with OpenOCD..."
	$(OPENOCD_CMD) -f $(OPENOCD_INTERFACE) -f $(OPENOCD_TARGET) -c "init; adapter speed $(OPENOCD_FREQ); halt; program $(ELF_FILE) verify reset exit"

# Program firmware (using .bin file with address, requires pre-built bin file)
openocd-prog-bin:
	@echo "Programming $(BIN_FILE) with OpenOCD..."
	$(OPENOCD_CMD) -f $(OPENOCD_INTERFACE) -f $(OPENOCD_TARGET) -c "init; adapter speed $(OPENOCD_FREQ); halt; program $(BIN_FILE) 0x08000000 verify reset exit"

# Start OpenOCD GDB server
openocd-gdb:
	@echo "Starting OpenOCD GDB server on port $(GDB_PORT)..."
	$(OPENOCD_CMD) -f $(OPENOCD_INTERFACE) -f $(OPENOCD_TARGET) -c "gdb_port $(GDB_PORT); init; adapter speed $(OPENOCD_FREQ)"

# Reset target
openocd-reset:
	@echo "Resetting target..."
	$(OPENOCD_CMD) -f $(OPENOCD_INTERFACE) -f $(OPENOCD_TARGET) -c "init; adapter speed $(OPENOCD_FREQ); reset; exit"

# Halt target
openocd-halt:
	@echo "Halting target..."
	$(OPENOCD_CMD) -f $(OPENOCD_INTERFACE) -f $(OPENOCD_TARGET) -c "init; adapter speed $(OPENOCD_FREQ); halt; exit"

# GDB debug - requires openocd-gdb running in another terminal
openocd-debug: $(ELF_FILE)
	@echo "Starting GDB debug session..."
	@echo "Make sure to run 'make openocd-gdb' in another terminal first"
	$(GDB) $(ELF_FILE) -x $(GDB_SCRIPT)

# Test SRAM Read/Write Speed
# Requires test_sram.bin file (generated by --gen-test-bin)
TEST_BIN ?= test_sram.bin
TEST_SRAM_ADDR ?= 0x20000000
TEST_SRAM_SIZE ?= 0x5000

openocd-sram:
	@echo "Testing SRAM Speed..."
	@echo "Loading $(TEST_BIN) to SRAM at $(TEST_SRAM_ADDR)..."
	$(OPENOCD_CMD) -f $(OPENOCD_INTERFACE) -f $(OPENOCD_TARGET) -c "init; adapter speed $(OPENOCD_FREQ); halt; load_image $(TEST_BIN) $(TEST_SRAM_ADDR) bin; exit"
	@echo "Dumping SRAM to verify..."
	$(OPENOCD_CMD) -f $(OPENOCD_INTERFACE) -f $(OPENOCD_TARGET) -c "init; adapter speed $(OPENOCD_FREQ); halt; dump_image sram_dump.bin $(TEST_SRAM_ADDR) $(TEST_SRAM_SIZE); exit"
	@echo "SRAM test complete. Compare $(TEST_BIN) and sram_dump.bin"

# OpenOCD RTT Support
# Note: RTT_ADDR should be obtained from the map file (_SEGGER_RTT symbol)
# Example: RTT_ADDR = 0x20002000
RTT_ADDR ?= 0x20002000
RTT_SIZE ?= 0x2000
RTT_PORT ?= 9090

openocd-rtt:
	@echo "Starting OpenOCD RTT Server on port $(RTT_PORT)..."
	@echo "RTT Address: $(RTT_ADDR), Size: $(RTT_SIZE)"
	@echo "Note: Ensure _SEGGER_RTT is placed at $(RTT_ADDR) in your firmware"
	@echo "Run 'python rtt_logger.py' in another terminal to capture logs"
	$(OPENOCD_CMD) -f $(OPENOCD_INTERFACE) -f $(OPENOCD_TARGET) -c 'init; adapter speed $(OPENOCD_FREQ); rtt setup $(RTT_ADDR) $(RTT_SIZE) "SEGGER RTT"; rtt start; rtt polling_interval 1; rtt server start $(RTT_PORT) 0'

# Clean generated files
clean-openocd:
	@echo "Cleaning OpenOCD generated files..."
	-rm -f test_sram.bin sram_dump.bin rtt_log.txt

# Help
openocd-help:
	@echo "Build Targets:"
	@echo "  all             - Configure and build the project (default)"
	@echo "  build           - Build the project (configure if needed)"
	@echo "  cmake           - Run CMake configuration"
	@echo "  clean           - Clean build directory"
	@echo ""
	@echo "OpenOCD Targets:"
	@echo "  openocd-erase   - Erase entire flash"
	@echo "  openocd-prog    - Program firmware (.elf)"
	@echo "  openocd-prog-bin- Program firmware (.bin)"
	@echo "  openocd-gdb     - Start OpenOCD GDB server"
	@echo "  openocd-debug   - Start GDB debug session (requires openocd-gdb)"
	@echo "  openocd-reset   - Reset target"
	@echo "  openocd-halt    - Halt target"
	@echo "  openocd-sram    - Test SRAM read/write speed"
	@echo "  openocd-rtt     - Start OpenOCD RTT server"
	@echo "  clean-openocd   - Clean generated files"
	@echo ""
	@echo "Configuration:"
	@echo "  OPENOCD_ROOT      = $(OPENOCD_ROOT)"
	@echo "  OPENOCD           = $(OPENOCD)"
	@echo "  OPENOCD_SCRIPTS   = $(OPENOCD_SCRIPTS)"
	@echo "  OPENOCD_INTERFACE = $(OPENOCD_INTERFACE)"
	@echo "  OPENOCD_TARGET    = $(OPENOCD_TARGET)"
	@echo "  OPENOCD_FREQ      = $(OPENOCD_FREQ)"
	@echo "  ELF_FILE          = $(ELF_FILE)"
	@echo "  HEX_FILE          = $(HEX_FILE)"
	@echo "  BIN_FILE          = $(BIN_FILE)"
	@echo "  GDB               = $(GDB)"
	@echo "  GDB_PORT          = $(GDB_PORT)"
	@echo "  BUILD_DIR         = $(BUILD_DIR)"
	@echo "  CMAKE_BUILD_TYPE  = $(CMAKE_BUILD_TYPE)"
	@echo "  RTT_ADDR          = $(RTT_ADDR)"
