# JLink Makefile for MDK-ARM
# Auto-generated by uvprojx2cmake.py
# 
# This Makefile provides convenient targets for JLink debugging and programming
#
# Requirements:
#   - J-Link Software Pack installed and in PATH
#   - J-Link debugger connected to target
#
# Usage:
#   make jlink-erase    - Erase entire flash
#   make jlink-prog     - Program the firmware (using .hex file)
#   make jlink-prog-bin - Program the firmware (using .bin file)
#   make jlink-rtt      - Start RTT logger
#   make jlink-swo      - Start SWO viewer

# =============================================================================
# Configuration
# =============================================================================

# JLink device name (auto-detected or override)
JLINK_DEVICE ?= STM32F103RB

# Interface and speed
JLINK_IF ?= SWD
JLINK_SPEED ?= 25000

# Build output files
BUILD_DIR ?= build
HEX_FILE ?= $(BUILD_DIR)/MDK-ARM.hex
BIN_FILE ?= $(BUILD_DIR)/MDK-ARM.bin

# RTT search range (RAM address and size)
RTT_ADDR ?= 0x20002000
RTT_SIZE ?= 0x5000

# GDB configuration
GDB ?= arm-none-eabi-gdb
GDB_PORT ?= 3333
GDB_SCRIPT ?= jlink_gdb.script

# CMake configuration
CMAKE ?= cmake
CMAKE_BUILD_TYPE ?= Debug
CMAKE_GENERATOR ?= Ninja

# =============================================================================
# Targets
# =============================================================================

.PHONY: all build clean cmake jlink-erase jlink-prog jlink-prog-bin jlink-rtt jlink-swo jlink-gdb jlink-debug jlink-check clean-jlink jlink-help

# Default target: build everything
all: build

# CMake configure
cmake:
	@echo "Configuring with CMake..."
	$(CMAKE) -S . -B $(BUILD_DIR) -G $(CMAKE_GENERATOR) -DCMAKE_BUILD_TYPE=$(CMAKE_BUILD_TYPE)

# Build the project
build: cmake
	@echo "Building project..."
	$(CMAKE) --build $(BUILD_DIR)

# Clean build directory
clean:
	@echo "Cleaning build directory..."
	-rmdir /s /q $(BUILD_DIR) 2>nul || rm -rf $(BUILD_DIR) 2>/dev/null || true

# Erase entire flash
jlink-erase:
	@echo "Erasing flash..."
	@echo r > jlink_erase.script
	@echo h >> jlink_erase.script
	@echo erase >> jlink_erase.script
	@echo r >> jlink_erase.script
	@echo q >> jlink_erase.script
	JLink.exe -device $(JLINK_DEVICE) -if $(JLINK_IF) -speed $(JLINK_SPEED) -CommanderScript jlink_erase.script
	@del jlink_erase.script 2>nul || rm -f jlink_erase.script

# Program firmware using HEX file (requires pre-built hex file)
jlink-prog:
	@echo "Programming $(HEX_FILE)..."
	@echo r > jlink_prog.script
	@echo h >> jlink_prog.script
	@echo loadfile $(HEX_FILE) >> jlink_prog.script
	@echo r >> jlink_prog.script
	@echo q >> jlink_prog.script
	JLink.exe -device $(JLINK_DEVICE) -if $(JLINK_IF) -speed $(JLINK_SPEED) -CommanderScript jlink_prog.script
	@del jlink_prog.script 2>nul || rm -f jlink_prog.script

# Program firmware using BIN file (requires pre-built bin file)
jlink-prog-bin:
	@echo "Programming $(BIN_FILE)..."
	@echo r > jlink_prog.script
	@echo h >> jlink_prog.script
	@echo loadfile $(BIN_FILE) 0x08000000 >> jlink_prog.script
	@echo r >> jlink_prog.script
	@echo q >> jlink_prog.script
	JLink.exe -device $(JLINK_DEVICE) -if $(JLINK_IF) -speed $(JLINK_SPEED) -CommanderScript jlink_prog.script
	@del jlink_prog.script 2>nul || rm -f jlink_prog.script

# Start RTT Logger
jlink-rtt:
	@echo "Starting RTT Logger (output: rtt.txt)..."
	JLinkRTTLogger.exe -Device $(JLINK_DEVICE) -If $(JLINK_IF) -Speed $(JLINK_SPEED) \
		-RTTSearchRanges "$(RTT_ADDR) $(RTT_SIZE)" \
		-RTTChannel 0 rtt.txt

# Start SWO Viewer
jlink-swo:
	@echo "Starting SWO Viewer (output: swo.log)..."
	JLinkSWOViewerCL.exe -device $(JLINK_DEVICE) -cpufreq 72000000 -swofreq 36000000 -itmport 0 -outputfile swo.log

# Start GDB Server
jlink-gdb:
	@echo "Starting JLink GDB Server on port $(GDB_PORT)..."
	JLinkGDBServerCL.exe -device $(JLINK_DEVICE) -if $(JLINK_IF) -speed $(JLINK_SPEED) -port $(GDB_PORT)

# Check JLink connection
jlink-check:
	@echo "Checking JLink connection..."
	@echo r > jlink_check.script
	@echo h >> jlink_check.script
	@echo q >> jlink_check.script
	JLink.exe -device $(JLINK_DEVICE) -if $(JLINK_IF) -speed $(JLINK_SPEED) -CommanderScript jlink_check.script
	@del jlink_check.script 2>nul || rm -f jlink_check.script

# GDB debug - requires jlink-gdb-server running in another terminal
jlink-debug: $(BUILD_DIR)/MDK-ARM.elf
	@echo "Starting GDB debug session..."
	@echo "Make sure to run 'make jlink-gdb' in another terminal first"
	$(GDB) $(BUILD_DIR)/MDK-ARM.elf -x $(GDB_SCRIPT)

# Clean generated files
clean-jlink:
	@del jlink_*.script 2>nul || rm -f jlink_*.script
	@del *.log 2>nul || rm -f *.log
	@del $(GDB_SCRIPT) 2>nul || rm -f $(GDB_SCRIPT)

# Help
jlink-help:
	@echo "Build Targets:"
	@echo "  all             - Configure and build the project (default)"
	@echo "  build           - Build the project (configure if needed)"
	@echo "  cmake           - Run CMake configuration"
	@echo "  clean           - Clean build directory"
	@echo ""
	@echo "JLink Targets:"
	@echo "  jlink-erase     - Erase entire flash"
	@echo "  jlink-prog      - Program firmware (.hex)"
	@echo "  jlink-prog-bin  - Program firmware (.bin)"
	@echo "  jlink-rtt       - Start RTT logger"
	@echo "  jlink-swo       - Start SWO viewer"
	@echo "  jlink-gdb       - Start GDB server"
	@echo "  jlink-debug     - Start GDB debug session (requires jlink-gdb)"
	@echo "  jlink-check     - Check JLink connection"
	@echo "  clean-jlink     - Clean generated files"
	@echo ""
	@echo "Configuration:"
	@echo "  JLINK_DEVICE    = $(JLINK_DEVICE)"
	@echo "  JLINK_IF        = $(JLINK_IF)"
	@echo "  JLINK_SPEED     = $(JLINK_SPEED)"
	@echo "  HEX_FILE        = $(HEX_FILE)"
	@echo "  BIN_FILE        = $(BIN_FILE)"
	@echo "  GDB             = $(GDB)"
	@echo "  BUILD_DIR       = $(BUILD_DIR)"
	@echo "  CMAKE_BUILD_TYPE= $(CMAKE_BUILD_TYPE)"
	@echo "  GDB_PORT     = $(GDB_PORT)"
