# PyOCD Makefile for MDK-ARM
# Auto-generated by uvprojx2cmake.py
# 
# This Makefile provides convenient targets for PyOCD debugging and programming
#
# Requirements:
#   - pyocd installed: pip install pyocd
#   - CMSIS-Pack for target device installed
#
# Usage:
#   make pyocd-erase    - Erase entire flash
#   make pyocd-prog     - Program the firmware (using .hex file)
#   make pyocd-prog-bin - Program the firmware (using .bin file)
#   make pyocd-gdb      - Start PyOCD GDB server
#   make pyocd-debug    - Start GDB debug session (requires pyocd-gdb)
#   make pyocd-rtt      - Start RTT client

# =============================================================================
# Configuration
# =============================================================================

# PyOCD target device (auto-detected or override)
PYOCD_TARGET ?= stm32f103rb

# PyOCD frequency (Hz)
PYOCD_FREQ ?= 10000000

# GDB configuration
GDB ?= arm-none-eabi-gdb
GDB_PORT ?= 3333
GDB_SCRIPT ?= jlink_gdb.script

# Build output files
BUILD_DIR ?= build
HEX_FILE ?= $(BUILD_DIR)/MDK-ARM.hex
BIN_FILE ?= $(BUILD_DIR)/MDK-ARM.bin

# CMake configuration
CMAKE ?= cmake
CMAKE_BUILD_TYPE ?= Debug
CMAKE_GENERATOR ?= Ninja

# =============================================================================
# Targets
# =============================================================================

.PHONY: all build clean cmake pyocd-erase pyocd-prog pyocd-prog-bin pyocd-gdb pyocd-debug pyocd-rtt pyocd-reset pyocd-help

# Default target: build everything
all: build

# CMake configure
cmake:
	@echo "Configuring with CMake..."
	$(CMAKE) -S . -B $(BUILD_DIR) -G $(CMAKE_GENERATOR) -DCMAKE_BUILD_TYPE=$(CMAKE_BUILD_TYPE)

# Build the project
build: cmake
	@echo "Building project..."
	$(CMAKE) --build $(BUILD_DIR)

# Clean build directory
clean:
	@echo "Cleaning build directory..."
	-rmdir /s /q $(BUILD_DIR) 2>nul || rm -rf $(BUILD_DIR) 2>/dev/null || true

# Erase entire flash
pyocd-erase:
	@echo "Erasing flash with pyocd..."
	pyocd erase -c -t $(PYOCD_TARGET)

# Program firmware using HEX file (requires pre-built hex file)
pyocd-prog:
	@echo "Programming $(HEX_FILE) with pyocd..."
	pyocd flash -t $(PYOCD_TARGET) $(HEX_FILE) -f $(PYOCD_FREQ)

# Program firmware using BIN file (requires pre-built bin file)
pyocd-prog-bin:
	@echo "Programming $(BIN_FILE) with pyocd..."
	pyocd flash -t $(PYOCD_TARGET) $(BIN_FILE) -f $(PYOCD_FREQ) --base-address 0x08000000

# Start PyOCD GDB server
pyocd-gdb:
	@echo "Starting PyOCD GDB server on port $(GDB_PORT) ($(PYOCD_FREQ) Hz)..."
	pyocd gdbserver -t $(PYOCD_TARGET) -p $(GDB_PORT) -f $(PYOCD_FREQ)

# Start RTT client (30MHz, output to rtt.txt)
pyocd-rtt:
	@echo "Starting PyOCD RTT client (30MHz, output to rtt.txt)..."
	pyocd rtt -t $(PYOCD_TARGET) -f 30000000 -a 0x20002000 -d rtt.txt

# Reset target
pyocd-reset:
	@echo "Resetting target..."
	pyocd reset -t $(PYOCD_TARGET)

# GDB debug - requires pyocd-gdb running in another terminal
pyocd-debug: $(BUILD_DIR)/MDK-ARM.elf
	@echo "Starting GDB debug session..."
	@echo "Make sure to run 'make pyocd-gdb' in another terminal first"
	$(GDB) $(BUILD_DIR)/MDK-ARM.elf -x $(GDB_SCRIPT)

# Clean generated files
clean-pyocd:
	@del $(GDB_SCRIPT) 2>nul || rm -f $(GDB_SCRIPT)

# Help
pyocd-help:
	@echo "Build Targets:"
	@echo "  all             - Configure and build the project (default)"
	@echo "  build           - Build the project (configure if needed)"
	@echo "  cmake           - Run CMake configuration"
	@echo "  clean           - Clean build directory"
	@echo ""
	@echo "PyOCD Targets:"
	@echo "  pyocd-erase     - Erase entire flash"
	@echo "  pyocd-prog      - Program firmware (.hex)"
	@echo "  pyocd-prog-bin  - Program firmware (.bin)"
	@echo "  pyocd-gdb       - Start PyOCD GDB server"
	@echo "  pyocd-debug     - Start GDB debug session (requires pyocd-gdb)"
	@echo "  pyocd-rtt       - Start RTT client"
	@echo "  pyocd-reset     - Reset target"
	@echo "  clean-pyocd     - Clean generated files"
	@echo ""
	@echo "Configuration:"
	@echo "  PYOCD_TARGET    = $(PYOCD_TARGET)"
	@echo "  PYOCD_FREQ      = $(PYOCD_FREQ)"
	@echo "  HEX_FILE        = $(HEX_FILE)"
	@echo "  BIN_FILE        = $(BIN_FILE)"
	@echo "  GDB             = $(GDB)"
	@echo "  GDB_PORT        = $(GDB_PORT)"
	@echo "  BUILD_DIR       = $(BUILD_DIR)"
	@echo "  CMAKE_BUILD_TYPE= $(CMAKE_BUILD_TYPE)"
