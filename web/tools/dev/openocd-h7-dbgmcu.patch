+static int stm32h7_read_id_code(struct flash_bank *bank, uint32_t *id, bool *id_from_apb)
+{
+	struct stm32h7_flash_bank *stm32h7_info = bank->driver_priv;
+	struct target *debug = stm32h7_info->dbgmcu_target;
+	/* On H74x/H75x, the AXI DBGMCU alias can return zero or stale
+	 * data even after Cortex-M examination. AP2 exposes the APB view.
+	 */
+	if (debug && target_was_examined(debug) &&
+			target_read_u32(debug, DBGMCU_APB_IDCODE_REGISTER, id) == ERROR_OK &&
+			(*id & 0xfff) == DEVID_STM32H74_H75XX) {
+		*id_from_apb = true;
+		return ERROR_OK;
+	}
+
+	return target_read_u32(bank->target, DBGMCU_IDCODE_REGISTER, id);
 }
 
