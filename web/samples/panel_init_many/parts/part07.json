      "lcdc_int_cfg_dsi.freq = ILI8688E_DSI_FREQ = DSI_FREQ_480Mbps = 480000000（bf0_hal_dsi.h）；#if 0//def APP_BSP_TEST 死代码分支为 240Mbps/2 数据 lane",
