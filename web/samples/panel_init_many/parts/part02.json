        "table_name": null,
        "steps": [
          {"type": "reset", "state": 0},
          {"type": "delay_us", "us": 10},
          {"type": "reset", "state": 1}
        ]
      }
    ],
    "display_on_sequence": [
      {"type": "comment", "text": "//LCD_WriteReg(hlcdc, REG_DISPLAY_ON(0x29), NULL, 0) 被注释；有效代码为 #ifdef SF32LB58X:"},
      {"type": "comment", "text": "hwp_lptim3->ARR = 32768 / lcdc_int_cfg.freq (=60, 整数除法=546); CMP = ARR/2; CR |= LPTIM_CR_ENABLE|LPTIM_CR_CNTSTRT"},
      {"type": "comment", "text": "MODIFY_REG(hwp_lpsys_aon->CR1, PBR_SEL0=2<<SEL0_Pos, PBR_SEL1=3<<SEL1_Pos)"},
      {"type": "comment", "text": "hwp_rtc: PBR3R|=3<<SEL(frp), PBR4R|=2<<SEL(xfrp), PBR5R|=3<<SEL(vcom)"}
    ],
    "display_off_sequence": [],
    "notes": [
      "无初始化命令表：LCD_Init 仅 BSP_LCD_Reset(0)->HAL_Delay_us(10)->BSP_LCD_Reset(1)。",
      "LCD_DisplayOn 中真正的显示开启命令 //LCD_WriteReg(hlcdc, REG_DISPLAY_ON, NULL, 0) 被注释；有效代码为 SF32LB58X 平台寄存器配置（LPTIM3 帧率时钟、LPSYS/RTC PBR 极性），非 LCD 命令，以 comment 步骤如实记录。",
      "interface=.freq=60：JDI 并行接口配置 freq 语义疑为帧率(Hz)而非时钟 Hz，按原值 60 记录于 freq_hz。",
      "valid_columns/valid_rows 为 THE_LCD_PIXEL_WIDTH/HEIGHT 宏（240/240），已按宏值换算为数字。",
      "ic 按导出名与文件注释（'JDI387A chip IDs'/'JDI387A Size'）取 JDI387A；无更具体屏型号注释/宏，panel=null。",
      "LCD_SetRegion 用 (0, Ypos0, THE_LCD_PIXEL_WIDTH-1, Ypos1)，不支持部分列刷新。",
      "LCD_ReadID 返回固定 THE_LCD_ID 0x1d1（读操作不记录）。"
    ]
  }
]
