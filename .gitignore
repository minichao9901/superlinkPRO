# 孤立的 UART 时钟实验
firmware/application_5301/build_uart*/

# ——— 白名单：随仓库发布的镜像 ELF（同目录其余 CMake 产物仍忽略）———
!firmware/bootloader_dfu/build_xip_evklite/
firmware/bootloader_dfu/build_xip_evklite/*
!firmware/bootloader_dfu/build_xip_evklite/output/
firmware/bootloader_dfu/build_xip_evklite/output/*
!firmware/bootloader_dfu/build_xip_evklite/output/akaLinkPro_Boot.elf

!firmware/application_5301/build_dfu_evklite/
firmware/application_5301/build_dfu_evklite/*
!firmware/application_5301/build_dfu_evklite/output/
firmware/application_5301/build_dfu_evklite/output/*
!firmware/application_5301/build_dfu_evklite/output/akaLinkPro_App.elf

# ——— 白名单：F103 的两套构建（cb / ze）里的 fw.elf + fw.bin + fw.hex 都入库 ———
# （用户可直接烧录并载入 ELF；.map 是机器生成的辅助文件，继续忽略）
!script_test/stm32f103_rtt_speed/build-cb/
